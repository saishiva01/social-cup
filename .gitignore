# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.turbo/
*.tsbuildinfo
.expo/
.expo-shared/
web-build/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor/OS/tooling
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
.kilo/

# Testing
coverage/
playwright-report/
test-results/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions and should be committed, the same way a package-lock.json is.

# Database
*.sqlite

# Misc
*.pem
.cache/
