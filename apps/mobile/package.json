  "devDependencies": {
    "@social-cup/config": "workspace:*",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.2",
    "eslint": "^9.12.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3"
  }
