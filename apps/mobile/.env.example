# Only variables prefixed EXPO_PUBLIC_ are readable at runtime by the app —
# Expo embeds them at build time. Never put a secret behind this prefix.
#
# `localhost` here only works from the iOS Simulator. A physical phone
# running Expo Go resolves `localhost` to itself, not your dev machine — it
# has no way to reach a server listening only on your machine's own loopback
# interface. For a physical device, replace this with your dev machine's LAN
# IP and the API's actual PORT (apps/api/.env, default 3000 — check it
# rather than guessing, a mismatched port fails as a plain connection error
# with no server-side log), e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Stripe publishable key (PRD Module 7) — not a secret, safe to embed in the
# client bundle; it only identifies the Stripe account, it cannot move money
# on its own. Test-mode key from https://dashboard.stripe.com/test/apikeys.
# Must match whichever Stripe account apps/api's STRIPE_SECRET_KEY belongs to.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-stripe-test-publishable-key

# ISO country code of the Social Cup business entity, required by Stripe's
# PaymentSheet to configure Apple Pay/Google Pay correctly.
EXPO_PUBLIC_STRIPE_MERCHANT_COUNTRY_CODE=US
