NODE_ENV=development
PORT=3000

# Local Docker Postgres (see docker-compose.yml at repo root — host port 5433,
# not 5432, to avoid colliding with a natively installed Postgres service)
DATABASE_URL=postgres://social_cup:social_cup_dev@localhost:5433/social_cup_dev
DATABASE_SSL=false

# Comma-separated list of browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-a-random-32-byte-hex-string
REFRESH_TOKEN_SECRET=replace-with-a-different-random-32-byte-hex-string

# Optional locally; required in staging/production.
SENTRY_DSN=

LOG_LEVEL=info

# Transactional email. One SMTP transport for every environment: local
# MailDev (no auth, port 1025 — see docker-compose.yml) and Amazon SES's
# SMTP interface in staging/production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave blank for local MailDev; set for SES SMTP credentials.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Social Cup <no-reply@socialcup.app>

# Deep-link prefixes embedded in the verification/reset emails. The defaults
# target the production app's socialcup:// scheme. In local Expo Go the
# scheme is exp://<dev-machine-ip>:8081, so override with e.g.
# EMAIL_VERIFICATION_URL_PREFIX=exp://192.168.1.10:8081/--/verify-email?token=
# PASSWORD_RESET_URL_PREFIX=exp://192.168.1.10:8081/--/reset-password?token=
EMAIL_VERIFICATION_URL_PREFIX=socialcup://verify-email?token=
PASSWORD_RESET_URL_PREFIX=socialcup://reset-password?token=
