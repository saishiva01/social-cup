NODE_ENV=development
PORT=3000

# Local Docker Postgres (see docker-compose.yml at repo root — host port 5433,
# not 5432, to avoid colliding with a natively installed Postgres service)
DATABASE_URL=postgres://social_cup:social_cup_dev@localhost:5433/social_cup_dev
DATABASE_SSL=false

# Comma-separated list of browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-a-random-32-byte-hex-string
REFRESH_TOKEN_SECRET=replace-with-a-different-random-32-byte-hex-string

# Optional locally; required in staging/production.
SENTRY_DSN=

LOG_LEVEL=info

# Transactional email (verification, password reset), sent through the
# EmailService abstraction (apps/api/src/services/email/). EMAIL_PROVIDER
# selects the implementation:
#   maildev  -> local SMTP catcher (see docker-compose.yml), no real delivery
#   resend   -> Resend's HTTP API, real delivery (staging/production)
# NODE_ENV=production requires EMAIL_PROVIDER=resend (enforced at startup) —
# production must never silently fall back to MailDev.
EMAIL_PROVIDER=maildev

# Used when EMAIL_PROVIDER=maildev.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Used when EMAIL_PROVIDER=resend. Get this from https://resend.com/api-keys
# — the sending domain in EMAIL_FROM below must be verified in the Resend
# dashboard first, or every send is rejected. See apps/web/README.md.
RESEND_API_KEY=

EMAIL_FROM=Social Cup <no-reply@socialcup.app>

# Base URL of the public web app (apps/web) that hosts the verification and
# password-reset landing pages linked from emails — see
# docs/architecture/authentication.md. Must be a real https:// origin in
# staging/production (e.g. https://socialcup.app); this default matches
# apps/web's local dev server.
APP_WEB_URL=http://localhost:5175

# Stripe (PRD Module 7 — membership/credits). Test-mode secret key from
# https://dashboard.stripe.com/test/apikeys. Never a live key locally.
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-test-secret-key

# Signing secret for verifying webhook payloads. For local development, run
# `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe` (Stripe
# CLI) and copy the "whsec_..." secret it prints — see
# docs/architecture/payments.md for the full local Stripe workflow.
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-listen-output

# The one $24.99/month plan's Stripe Price id (test mode) — create it once in
# the Stripe test dashboard (Product catalog) and paste the "price_..." id
# here. The server owns this value; the mobile client never supplies a price.
STRIPE_PRICE_ID=price_replace-with-your-test-mode-price-id

# Must match the API version @stripe/stripe-react-native (apps/mobile) is
# compiled against — see docs/architecture/payments.md. The default below is
# a safe, current version; change only if mobile's Stripe SDK requires a
# different one.
STRIPE_API_VERSION=2024-06-20
