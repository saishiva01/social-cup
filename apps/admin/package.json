{
  "name": "@social-cup/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Social Cup admin panel (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
